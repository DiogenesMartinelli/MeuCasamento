# --- Supabase Postgres (Prisma) ---
# Project Settings > Database > Connection string
# Pooled connection (pgbouncer, port 6543) - used at runtime by the app
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used only by `prisma migrate`
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth + Storage ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# Service role key - server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY="ey..."
# Name of the public Storage bucket used for uploaded images
SUPABASE_STORAGE_BUCKET="meucasamento"

# --- Mercado Pago ---
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="xxxxxxxx"

# --- Resend (transactional email: expiry reminders + end-of-contract data export) ---
# https://resend.com/api-keys - without a verified domain, delivery is limited to your
# own signup email. Verify a domain in Resend to email real couples in production.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="MeuCasamento <onboarding@resend.dev>"

# --- Cron (protects /api/cron/account-lifecycle, called daily by Vercel Cron) ---
# Any long random string - Vercel automatically sends it as `Authorization: Bearer <value>`
# to this project's cron jobs once it's set as an env var here.
CRON_SECRET="xxxxxxxx"

# --- App ---
# Public base URL of the deployed app, used to build absolute redirect/webhook URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
