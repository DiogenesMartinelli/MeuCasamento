// Prisma schema - MeuCasamento (multi-tenant wedding site & admin platform)
// https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // "client" = the WASM/JS query compiler, so the query engine binary is never
  // needed at all - the pg driver adapter (src/lib/prisma.ts) handles everything.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GiftType {
  PHYSICAL_LINK
  CASH_QUOTA
}

enum GiftStatus {
  AVAILABLE
  PURCHASED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SiteTemplate {
  CLASSIC
  MODERN
  RUSTIC
  BOHO
  MINIMAL
  ROMANTIC
  CUSTOM
}

enum GiftCardShape {
  SQUARE
  ROUNDED
  SOFT
  PILL
  OVAL
}

/// One row per couple/wedding. Everything else in the system hangs off an Account,
/// which is how the platform supports multiple weddings (multi-tenant).
model Account {
  id          String   @id @default(uuid())
  /// Public URL slug, e.g. /c/joao-e-maria
  slug        String   @unique
  /// Supabase auth.users.id of the couple/admin that owns this account.
  ownerUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siteSettings  SiteSettings?
  events        Event[]
  guestMessages GuestMessage[]

  @@map("accounts")
}

model SiteSettings {
  id                  String        @id @default(uuid())
  accountId           String        @unique
  account             Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  coupleName          String        @default("")
  welcomeMessage      String        @default("")
  backgroundImageUrl  String?
  bannerImageUrl      String?
  profileImageUrl     String?
  template            SiteTemplate  @default(CLASSIC)
  /// Shown to a guest after they choose "não poderei comparecer" on the RSVP page.
  declineMessage      String        @default("Que pena! Sentiremos sua falta, mas agradecemos por avisar. 💛")
  /// Optional hex colors overriding the template's defaults. Any left unset falls
  /// back to the chosen template's own palette. The CUSTOM template exposes all
  /// six in the admin UI; other templates only expose the first three.
  accentColor         String?
  backgroundColor     String?
  textColor           String?
  mutedTextColor      String?
  cardBackgroundColor String?
  borderColor         String?
  giftCardShape       GiftCardShape @default(ROUNDED)
  /// When true, the RSVP flow asks "quer presentear o casal?" before showing the
  /// gift list. When false, it goes straight from the thank-you message to the list.
  askGiftIntent       Boolean       @default(true)
  updatedAt           DateTime      @updatedAt

  @@map("site_settings")
}

model Event {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  guests Guest[]
  gifts  Gift[]

  @@index([accountId])
  @@map("events")
}

model Guest {
  id          String      @id @default(uuid())
  accountId   String
  name        String
  /// WhatsApp-reachable phone number for the family, used to send the RSVP link/QR code.
  /// Only needs to be set on one member of a family for the "send" actions to work.
  phone       String?
  /// Shared by every member of the same family unit so one link (/rsvp/[familyToken])
  /// confirms the whole family at once.
  familyToken String      @default(uuid())
  status      GuestStatus @default(PENDING)
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([accountId])
  @@index([familyToken])
  @@map("guests")
}

model Gift {
  id          String     @id @default(uuid())
  accountId   String
  title       String
  description String?
  /// Only set when type = CASH_QUOTA.
  price       Decimal?   @db.Decimal(10, 2)
  productUrl  String?
  imageUrl    String?
  type        GiftType
  status      GiftStatus @default(AVAILABLE)
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  payments Payment[]

  @@index([accountId])
  @@index([eventId])
  @@map("gifts")
}

/// Tracks a Mercado Pago checkout attempt for a CASH_QUOTA gift, so the webhook
/// has something idempotent to update when payment status changes.
model Payment {
  id             String        @id @default(uuid())
  giftId         String
  gift           Gift          @relation(fields: [giftId], references: [id], onDelete: Cascade)
  mpPreferenceId String?
  mpPaymentId    String?       @unique
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  payerName      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([giftId])
  @@map("payments")
}

/// A one-time payment required to unlock account creation - the couple pays before
/// they ever get a Supabase Auth user or an Account. Card-only, goes to the
/// platform owner's Mercado Pago account (this is platform revenue, not a gift).
model RegistrationPayment {
  id             String        @id @default(uuid())
  email          String
  status         PaymentStatus @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  /// Set once this payment has been consumed to create an Account, so it can't be reused.
  usedAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([email])
  @@map("registration_payments")
}

model GuestMessage {
  id         String   @id @default(uuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorName String
  content    String
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@map("guest_messages")
}
